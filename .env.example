# OpenAI Configuration
OPENAI_API_KEY=''
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# PostgreSQL with Pgvector Configuration
DATABASE_URL=postgresql://neondb_owner:npg_PHh1Ux7qkZAN@ep-billowing-queen-ahfxzvi1-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
POSTGRES_HOST=ep-billowing-queen-ahfxzvi1-pooler.c-3.us-east-1.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=neondb
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=npg_PHh1Ux7qkZAN

# Vector Store Configuration
VECTOR_STORE_TYPE=faiss  # Options: faiss, pgvector
FAISS_INDEX_PATH=./data/faiss_index

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=5
RELEVANCE_THRESHOLD=0.7

# Corrective RAG Settings
ENABLE_CORRECTIVE_RAG=true
MAX_RETRY_ATTEMPTS=2
FALLBACK_TO_WEB_SEARCH=false

# Logging
LOG_LEVEL=INFO
